.intro { margin-bottom: 28rpx; }
.tile-card { padding: 24rpx 16rpx; }
.input-row { display: flex; justify-content: space-between; margin: 0 8rpx 12rpx; font-size: 26rpx; }
.tiles { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.tile { flex: 0 0 calc(100% / 9 - 6rpx); width: calc(100% / 9 - 6rpx); min-width: 0; padding: 0; margin: 6rpx 3rpx; line-height: 76rpx; font-size: 24rpx; border-radius: 8rpx; background: #edf5f1; color: #245d4c; white-space: nowrap; box-sizing: border-box; }
.tile::after { border: 1rpx solid #d0ddd6; border-radius: 8rpx; }
.suit-m { color: #9d4638; }.suit-p { color: #3c6385; }.suit-s { color: #245d4c; }
.chosen { background: #e5ecea; }
.meld-list, .small-actions { display: flex; flex-wrap: wrap; }
.meld { font-size: 24rpx; margin: 8rpx; padding: 0 14rpx; background: #e6eee8; }
.small-actions button { flex: 1; margin: 16rpx 8rpx 0; }
.section-title { font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #eef1ee; font-size: 26rpx; gap: 14rpx; }
picker.setting-row { display: block; } picker.setting-row text { display: block; color: #147d64; margin-top: 8rpx; }
.setting-row switch { flex-shrink: 0; }
.number-grid { display: flex; gap: 16rpx; margin: 20rpx 0; }.number-grid label { flex: 1; min-width: 0; font-size: 24rpx; }
input { background: #f1f5f1; padding: 14rpx; border-radius: 10rpx; margin-top: 8rpx; height: 48rpx; }
.rules-toggle { background: #edf4ee; color: #245d4c; font-size: 26rpx; white-space: normal; line-height: 1.5; padding: 18rpx; }
.rule-table { margin: 20rpx 0; }.rule-row { display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #eef1ee; padding: 10rpx 0; font-size: 26rpx; }.fan-edit { display: flex; align-items: center; gap: 10rpx; }.fan-edit input { width: 66rpx; text-align: center; margin: 0; }
.source-link { background: transparent; color: #147d64; font-size: 24rpx; text-align: left; line-height: 1.6; padding: 10rpx 0; }.source-link::after { border: 0; }
.calculate { margin-bottom: 24rpx; }.result { line-height: 1.8; }.score-head { font-size: 46rpx; font-weight: 600; margin: 20rpx 0; }.score-head text { font-size: 28rpx; font-weight: 400; }.score-line { display: flex; justify-content: space-between; font-size: 28rpx; }.score-total { font-weight: 600; font-size: 34rpx; margin-top: 20rpx; }
